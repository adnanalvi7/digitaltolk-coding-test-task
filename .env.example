# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT_BYTES=1048576
# Unset = enabled outside production, disabled in production
SWAGGER_ENABLED=true
# Node cluster workers (stateless app: scale up to the CPU count)
APP_WORKERS=1

DATABASE_URL=postgres://postgres:postgres@localhost:5432/translations
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_IN_TX_TIMEOUT_MS=10000

REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=tms:

AUTH_TOKEN_DEFAULT_TTL_SECONDS=86400
AUTH_TOKEN_MAX_TTL_SECONDS=2592000
AUTH_LAST_USED_WRITE_INTERVAL_SECONDS=60
# Per-instance cache of verified tokens; revocation reaches other instances within this window (0 = off)
AUTH_TOKEN_CACHE_MS=5000
# Used only by `npm run seed` to create/update the admin user. Set your own.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

THROTTLE_WINDOW_MS=60000
THROTTLE_AUTH_LIMIT=5
THROTTLE_API_LIMIT=120
THROTTLE_EXPORT_LIMIT=600
# Failed authentications (bad token or password) per IP per window, then 429 for one window
THROTTLE_AUTH_FAILURE_LIMIT=30

# true = export is public and CDN-cacheable (ETag + s-maxage); false = requires export:read
EXPORT_PUBLIC=false
EXPORT_CACHE_TTL_SECONDS=300
# Postgres is the source of truth for the catalog version; Redis is re-synced this often
CATALOG_RECONCILE_INTERVAL_MS=5000
EXPORT_S_MAXAGE_SECONDS=60
EXPORT_STALE_WHILE_REVALIDATE_SECONDS=30
EXPORT_WARM_ON_CHANGE=false
EXPORT_BUILD_LOCK_MS=10000
# In-process LRU in front of Redis for compressed export documents (per instance)
EXPORT_MEMORY_CACHE_MB=64

# Optional CDN purge hook fired on every catalog version bump.
# CDN_PURGE_URL=https://api.cloudflare.com/client/v4/zones/<zone>/purge_cache
# CDN_PURGE_TOKEN=
# CDN_PUBLIC_BASE_URL=https://cdn.example.com
