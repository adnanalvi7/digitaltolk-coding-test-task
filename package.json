{
  "name": "translation-management-service",
  "version": "1.0.0",
  "description": "API-first translation management service: locales, tagged keys, search, and a fresh, CDN-ready JSON export.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:cov": "jest --config jest.coverage.config.ts --selectProjects unit e2e --runInBand --coverage",
    "test:perf": "npm run build && jest --config jest.perf.config.ts --runInBand",
    "perf:explain": "ts-node --transpile-only test/perf/explain-hot-queries.ts",
    "perf:export-build": "ts-node --transpile-only test/perf/export-build-bench.ts",
    "migrate": "node dist/cli/migrate.js latest",
    "migrate:down": "node dist/cli/migrate.js down",
    "migrate:dev": "ts-node --transpile-only src/cli/migrate.ts latest",
    "seed": "node dist/cli/seed.js",
    "seed:dev": "ts-node --transpile-only src/cli/seed.ts",
    "db:codegen": "kysely-codegen --dialect postgres --out-file src/database/schema.generated.ts --exclude-pattern kysely_*",
    "docs:openapi": "ts-node --transpile-only src/cli/openapi.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "fastify": "5.12.7",
    "ioredis": "^5.11.1",
    "kysely": "^0.28.17",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/autocannon": "^7.12.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "fastify": "$fastify",
    "js-yaml": "^5.4.3"
  }
}
